APP_NAME=IncuEdit
APP_ENV=development
DATA_DIR=./data
MAX_UPLOAD_MB=500
ALLOWED_ORIGINS=http://localhost:8000
TRANSCRIPTION_PROVIDER=manual
DIARIZATION_PROVIDER=none
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TIME_POLICY=current_timeline
PUBLIC_BASE_URL=http://localhost:8000
COST_ESTIMATE_USD_PER_VIDEO_MINUTE=0.0000
WEBHOOK_SECRET=replace_with_a_secure_random_secret_in_production
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=incuedit
S3_REGION=us-east-1
